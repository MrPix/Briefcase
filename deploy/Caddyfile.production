# ── Briefcase — Production Caddyfile ─────────────────────────────────────────
#
# HTTPS-first config for internet-facing production deploys.
# Set SITE_DOMAIN in docker-compose/.env (for example: briefcase.page).
# Caddy will obtain and auto-renew a Let's Encrypt certificate automatically.
# Keep ports 80 and 443 reachable from the internet for ACME validation.
# ─────────────────────────────────────────────────────────────────────────────

{$SITE_DOMAIN} {
    # ── Reverse proxy — REST API ──────────────────────────────────────────────
    # Use handle blocks so each block is mutually exclusive. Without this,
    # try_files (a rewrite-phase directive) runs before reverse_proxy and
    # rewrites /api/* paths to /index.html, causing file_server to return 405.
    handle /api/* {
        reverse_proxy api:8080
    }

    # ── Reverse proxy — SignalR WebSocket hub ────────────────────────────────
    handle /hubs/* {
        reverse_proxy api:8080 {
            # Keep WebSocket connections alive
            flush_interval -1
            transport http {
                versions 1.1 2
            }
        }
    }

    # ── Static React SPA ──────────────────────────────────────────────────────
    handle {
        root * /usr/share/caddy
        try_files {path} /index.html
        file_server

        # Cache immutable, content-hashed assets for one year.
        @static {
            path *.js *.css *.woff *.woff2 *.ttf *.png *.jpg *.jpeg *.gif *.svg *.ico *.webp
        }
        header @static Cache-Control "public, max-age=31536000, immutable"

        # Never cache the app shell or service worker so redeploys are detected
        # immediately and the PWA auto-updates without a hard reload.
        @noCache path /index.html /sw.js /registerSW.js /manifest.webmanifest
        header @noCache Cache-Control "no-cache, no-store, must-revalidate"
    }
}
