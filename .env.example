# ── Briefcase — environment variables ────────────────────────────────────────
# Copy this file to .env and fill in the values before running docker compose.
# .env is listed in .gitignore so secrets are never committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Image tag ────────────────────────────────────────────────────────────────
# Pin to a specific SHA tag (e.g. sha-a1b2c3d) or leave as "latest"
IMAGE_TAG=latest

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=briefcase
POSTGRES_PASSWORD=change_me_strong_password

# ── pgAdmin (PostgreSQL web UI) ──────────────────────────────────────────────
# Credentials for logging in to the pgAdmin web UI itself (separate from the
# database user above). Email can stay as the default; password is required.
PGADMIN_DEFAULT_EMAIL=admin@briefcase.page
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password

# ── JWT ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters long.
JWT_SECRET=change_me_use_a_strong_secret_min32chars!!
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=365

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_BUCKET_NAME=briefcase

# ── Public URL ───────────────────────────────────────────────────────────────
# The URL users open in their browser. Used for CORS AllowedOrigins.
# Examples:
#   http://192.168.1.100       (LAN IP, HTTP)
#   https://briefcase.home     (custom DNS + HTTPS)
PUBLIC_WEB_URL=http://localhost

# ── OAuth (Google sign-in) ──────────────────────────────────────────────────
# Configure in Google Cloud Console and use OAuth client credentials here.
# Redirect URI should point to the API callback (typically behind the same domain):
#   ${PUBLIC_WEB_URL}/api/auth/oauth/google/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Optional allowlist for client redirect targets used after OAuth callback.
# Needed mainly when API and Web have different origins/ports.
# Examples:
#   http://localhost:7205/login
#   http://localhost:7205/signup
OAUTH_ALLOWED_CLIENT_REDIRECT_URI_1=
OAUTH_ALLOWED_CLIENT_REDIRECT_URI_2=

# ── Production HTTPS domain (Caddy) ─────────────────────────────────────────
# Required for deploy/Caddyfile.production automatic TLS (Let's Encrypt).
# Set this to your real public domain without protocol.
# Example: briefcase.page
SITE_DOMAIN=briefcase.page
