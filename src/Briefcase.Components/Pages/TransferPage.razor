@page "/transfer"
@namespace Briefcase.Components.Pages
@inject ITransferService TransferService
@inject IMessageService MessageService
@inject IClipboardService ClipboardService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

@if (_isSendMode)
{
    @* ── Send mode: authenticated device shares a message ── *@
    <div class="transfer-container">
        <div class="transfer-card">
            <div class="transfer-method-tabs">
                <button class="transfer-tab @(_shareMethod == ShareMethod.Device ? "active" : "")"
                        @onclick="() => SetMethod(ShareMethod.Device)">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <rect x="5" y="2" width="14" height="20" rx="2" ry="2" />
                        <path d="M12 18h.01" stroke-linecap="round" />
                    </svg>
                    To device
                </button>
                <button class="transfer-tab @(_shareMethod == ShareMethod.Link ? "active" : "")"
                        @onclick="() => SetMethod(ShareMethod.Link)">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101
                        M10.172 13.828a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" stroke-linecap="round"
                              stroke-linejoin="round" />
                    </svg>
                    By link
                </button>
            </div>

            @if (_shareMethod == ShareMethod.Device)
            {
                <div class="transfer-icon send">
                    <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
                <h2 class="transfer-title">Send Message</h2>
                <p class="transfer-subtitle">Enter the 8-character code shown on the receiving device.</p>

                @if (!_sent)
                {
                    <div class="code-input-group">
                        <input class="code-input" type="text" maxlength="8" placeholder="ABCD1234" @bind="_enteredCode"
                               @bind:event="oninput" autocomplete="off" spellcheck="false" />
                    </div>

                    @if (_errorMessage is not null)
                    {
                        <div class="transfer-error">@_errorMessage</div>
                    }

                    <button class="transfer-btn primary" @onclick="HandleSend" disabled="@(_sending || _enteredCode.Length != 8)">
                        @if (_sending)
                        {
                            <span class="spinner"></span>
                            <span>Sending…</span>
                        }
                        else
                        {
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            <span>Send</span>
                        }
                    </button>
                }
                else
                {
                    <div class="transfer-success">
                        <svg width="32" height="32" fill="none" stroke="#22c55e" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <p>Message sent! The recipient can now open the link on their device.</p>
                    </div>
                    <button class="transfer-btn secondary" @onclick='() => NavigationManager.NavigateTo("/clipboard")'>
                        Back to Clipboard
                    </button>
                }
            }
            else
            {
                @* ── Share by link ── *@
                <div class="transfer-icon send">
                    <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101
                        M10.172 13.828a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" stroke-linecap="round"
                              stroke-linejoin="round" />
                    </svg>
                </div>
                <h2 class="transfer-title">Share by Link</h2>
                <p class="transfer-subtitle">Generate a public link anyone can open — no account required.</p>

                @if (_generatedUrl is null)
                {
                    <div class="link-options">
                        <label class="link-option-label" for="expiry-select">Link expires</label>
                        <select id="expiry-select" class="link-select" @bind="_expiryChoice">
                            <option value="60">After 1 hour</option>
                            <option value="1440">After 24 hours</option>
                            <option value="10080">After 7 days</option>
                            <option value="0">Never</option>
                        </select>

                        <label class="link-toggle">
                            <input type="checkbox" @bind="_oneTime" />
                            <span>Self-destruct after one view</span>
                        </label>
                    </div>

                    @if (_errorMessage is not null)
                    {
                        <div class="transfer-error">@_errorMessage</div>
                    }

                    <button class="transfer-btn primary" @onclick="HandleGenerateLink" disabled="@_generating">
                        @if (_generating)
                        {
                            <span class="spinner"></span>
                            <span>Generating…</span>
                        }
                        else
                        {
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101
                                M10.172 13.828a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
                                      stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            <span>Generate link</span>
                        }
                    </button>
                }
                else
                {
                    <div class="link-result">
                        <div class="link-url-box">
                            <input class="link-url-input" type="text" readonly value="@_generatedUrl" @onfocus="SelectLinkText"
                                   @ref="_linkInputRef" />
                            <button class="link-copy-btn" @onclick="CopyLink" title="Copy link">
                                @if (_copied)
                                {
                                    <svg width="16" height="16" fill="none" stroke="#22c55e" stroke-width="2" viewBox="0 0 24 24">
                                        <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                }
                                else
                                {
                                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                                        <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" stroke-linecap="round"
                                              stroke-linejoin="round" />
                                    </svg>
                                }
                            </button>
                        </div>
                        <p class="link-hint">@LinkHint</p>
                    </div>

                    <button class="transfer-btn secondary" @onclick="ResetLink">
                        Create another link
                    </button>
                }
            }
        </div>
    </div>
}
else
{
    @* ── Receive mode: unauthorized device shows an 8-char code and waits ── *@
    <div class="transfer-container">
        <div class="transfer-card">
            <div class="transfer-icon receive">
                <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3" stroke-linecap="round"
                          stroke-linejoin="round" />
                </svg>
            </div>
            <h2 class="transfer-title">Receive Message</h2>
            <p class="transfer-subtitle">Share this code with the sender. It expires in 10 minutes.</p>

            @if (_code is null)
            {
                <div class="transfer-loading">
                    <span class="spinner"></span>
                    <span>Generating code…</span>
                </div>
            }
            else if (_received)
            {
                <div class="transfer-success">
                    <svg width="32" height="32" fill="none" stroke="#22c55e" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <p>Message received! Opening…</p>
                </div>
            }
            else
            {
                <div class="code-display-group">
                    <span class="code-half">@_code[..4]</span>
                    <span class="code-separator">–</span>
                    <span class="code-half">@_code[4..]</span>
                </div>

                <div class="transfer-waiting">
                    <span class="pulse-dot"></span>
                    <span>Waiting for sender…</span>
                </div>
            }
            <button class="transfer-btn secondary" @onclick='() => NavigationManager.NavigateTo("/")'>
                Back
            </button>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public Guid? MessageId { get; set; }

    private enum ShareMethod { Device, Link }

    private bool _isSendMode;
    private ShareMethod _shareMethod = ShareMethod.Device;
    private string? _code;
    private bool _received;
    private string _enteredCode = string.Empty;
    private bool _sending;
    private bool _sent;
    private string? _errorMessage;
    private CancellationTokenSource? _cts;

    // Share-by-link state
    private string _expiryChoice = "1440";
    private bool _oneTime;
    private bool _generating;
    private string? _generatedUrl;
    private bool _copied;
    private ElementReference _linkInputRef;
    private ShareLinkResult? _linkResult;

    private string LinkHint => _linkResult switch
    {
        { OneTime: true } => "This link self-destructs after it is opened once.",
        { ExpiresAt: { } exp } => $"This link expires on {exp.ToLocalTime():yyyy-MM-dd HH:mm}.",
        _ => "This link never expires. Anyone with it can view the content."
    };

    protected override async Task OnInitializedAsync()
    {
        _isSendMode = MessageId.HasValue;

        if (!_isSendMode)
        {
            _code = await TransferService.CreateSessionAsync();
            _cts = new CancellationTokenSource();
            _ = StartListeningAsync(_cts.Token);
        }
    }

    private void SetMethod(ShareMethod method)
    {
        _shareMethod = method;
        _errorMessage = null;
    }

    private async Task StartListeningAsync(CancellationToken ct)
    {
        try
        {
            await TransferService.ListenForTransferAsync(_code!, async url =>
            {
                await InvokeAsync(() =>
                {
                    _received = true;
                    StateHasChanged();
                    NavigationManager.NavigateTo(url);
                });
            }, ct);
        }
        catch (OperationCanceledException) { /* disposed */ }
    }

    private async Task HandleSend()
    {
        _errorMessage = null;
        _sending = true;

        try
        {
            var code = _enteredCode.Trim().ToUpperInvariant();
            await TransferService.SendToAsync(code, MessageId!.Value);
            _sent = true;
        }
        catch (HttpRequestException ex) when ((int?)ex.StatusCode == 404)
        {
            _errorMessage = "Code not found or expired. Please check and try again.";
        }
        catch (Exception)
        {
            _errorMessage = "Something went wrong. Please try again.";
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task HandleGenerateLink()
    {
        _errorMessage = null;
        _generating = true;

        try
        {
            int? expiresInMinutes = int.TryParse(_expiryChoice, out var minutes) && minutes > 0
                ? minutes
                : null;

            var result = await MessageService.CreateShareLinkAsync(MessageId!.Value, _oneTime, expiresInMinutes);
            _linkResult = result;
            _generatedUrl = NavigationManager.ToAbsoluteUri(result.Url).ToString();
        }
        catch (Exception)
        {
            _errorMessage = "Could not create the link. Please try again.";
        }
        finally
        {
            _generating = false;
        }
    }

    private async Task CopyLink()
    {
        if (_generatedUrl is null)
            return;

        await ClipboardService.SetTextAsync(_generatedUrl);
        _copied = true;
        StateHasChanged();
    }

    private void ResetLink()
    {
        _generatedUrl = null;
        _linkResult = null;
        _copied = false;
        _errorMessage = null;
    }

    private void SelectLinkText()
    {
        _copied = false;
    }

    public async ValueTask DisposeAsync()
    {
        if (_cts is not null)
        {
            await _cts.CancelAsync();
            _cts.Dispose();
        }
    }
}

