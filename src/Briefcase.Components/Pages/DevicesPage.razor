@page "/devices"
@namespace Briefcase.Components.Pages
@inject IDeviceService DeviceService

<h1>Devices</h1>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="GeneratePairCode">
        <span class="bi bi-qr-code"></span> Generate Pair Code
    </button>
    <button class="btn btn-outline-primary ms-2" @onclick="() => _showScanner = true">
        <span class="bi bi-qr-code-scan"></span> Scan Pair Code
    </button>
    <button class="btn btn-outline-primary ms-2" @onclick="ToggleAddDevice">
        <span class="bi bi-plus-circle"></span> Add device
    </button>
</div>

@if (_showAddDevice)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Add a device with a code</h5>
            <p class="card-text text-muted">
                On the new device, choose <strong>Add this device</strong> to get an 8-character code,
                then enter it below.
            </p>
            <div class="input-group" style="max-width: 22rem;">
                <input class="form-control text-uppercase" maxlength="8" placeholder="Enter code" @bind="_addDeviceCode"
                       @bind:event="oninput" @onkeydown="@(e => { if (e.Key == "Enter") { _ = ApproveLoginCode(); } })"
                       disabled="@_isApproving" />
                <button class="btn btn-primary" @onclick="ApproveLoginCode"
                        disabled="@(_isApproving || string.IsNullOrWhiteSpace(_addDeviceCode))">
                    @if (_isApproving)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                    }
                    else
                    {
                        <span>Add</span>
                    }
                </button>
            </div>
            @if (_addDeviceError is not null)
            {
                <div class="text-danger mt-2">@_addDeviceError</div>
            }
            @if (_addDeviceSuccess is not null)
            {
                <div class="text-success mt-2">@_addDeviceSuccess</div>
            }
        </div>
    </div>
}

@if (_pairCode is not null)
{
    <div class="alert alert-info">
        <p>Share this code with the new device:</p>
        <code>@_pairCode</code>
    </div>
}

@if (_showScanner)
{
    <div class="mb-3">
        <Briefcase.Components.Components.QrScanner OnScanned="HandlePairCodeScanned" />
    </div>
}

@if (_devices is null)
{
    <p><em>Loading devices...</em></p>
}
else if (_devices.Count == 0)
{
    <p class="text-muted">No registered devices.</p>
}
else
{
    <div class="list-group">
        @foreach (var device in _devices)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>@device.Name</strong>
                    <span class="badge bg-secondary ms-2">@device.Platform</span>
                    <br />
                    <small class="text-muted">Last seen: @device.LastSeenAt.ToString("g")</small>
                </div>
                <button class="btn btn-outline-danger btn-sm" @onclick="() => RemoveDevice(device.Id)">
                    <span class="bi bi-trash"></span> Remove
                </button>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<Device>? _devices;
    private string? _pairCode;
    private bool _showScanner;

    private bool _showAddDevice;
    private string _addDeviceCode = string.Empty;
    private bool _isApproving;
    private string? _addDeviceError;
    private string? _addDeviceSuccess;

    protected override async Task OnInitializedAsync()
    {
        await LoadDevices();
    }

    private async Task LoadDevices()
    {
        _devices = await DeviceService.GetDevicesAsync();
    }

    private async Task RemoveDevice(Guid deviceId)
    {
        await DeviceService.RemoveDeviceAsync(deviceId);
        await LoadDevices();
    }

    private async Task GeneratePairCode()
    {
        _pairCode = await DeviceService.GeneratePairCodeAsync();
    }

    private async Task HandlePairCodeScanned(string token)
    {
        await DeviceService.ClaimDeviceAsync(token);
        _showScanner = false;
        await LoadDevices();
    }

    private void ToggleAddDevice()
    {
        _showAddDevice = !_showAddDevice;
        _addDeviceError = null;
        _addDeviceSuccess = null;
    }

    private async Task ApproveLoginCode()
    {
        if (_isApproving || string.IsNullOrWhiteSpace(_addDeviceCode))
            return;

        _isApproving = true;
        _addDeviceError = null;
        _addDeviceSuccess = null;

        try
        {
            var deviceName = await DeviceService.ApproveLoginCodeAsync(_addDeviceCode.Trim());
            _addDeviceSuccess = $"“{deviceName}” has been signed in.";
            _addDeviceCode = string.Empty;
            await LoadDevices();
        }
        catch (Exception ex)
        {
            _addDeviceError = ex.Message;
        }
        finally
        {
            _isApproving = false;
        }
    }
}
