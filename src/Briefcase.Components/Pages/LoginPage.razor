@page "/login"
@namespace Briefcase.Components.Pages
@inject IAuthService AuthService
@inject IDeviceService DeviceService
@inject IDeviceInfoProvider DeviceInfo
@inject NavigationManager Navigation
@implements IDisposable

<div class="auth-container">
    <div class="auth-card">
        <h2 class="auth-title">Sign In</h2>
        <p class="auth-subtitle">Welcome back! Sign in to your account.</p>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }

        <EditForm Model="_model" OnValidSubmit="HandleLogin" FormName="loginForm">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <InputText id="email" class="form-control" @bind-Value="_model.Email" placeholder="you@example.com" />
                <ValidationMessage For="() => _model.Email" />
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="_model.Password"
                           placeholder="Enter your password" />
                <ValidationMessage For="() => _model.Password" />
            </div>

            <button type="submit" class="btn btn-primary w-100" disabled="@_isLoading">
                @if (_isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <span>Signing in…</span>
                }
                else
                {
                    <span>Sign In</span>
                }
            </button>
        </EditForm>

        <div class="auth-divider">
            <span>or</span>
        </div>

        @foreach (var provider in AuthService.ExternalProviders)
        {
            <button type="button" class="btn btn-outline-secondary w-100 auth-social-btn"
                    @onclick="() => StartExternalLogin(provider.Key)" disabled="@_isLoading">
                Continue with @provider.DisplayName
            </button>
        }

        <div class="auth-footer">
            <span>Don't have an account?</span>
            <a href="/signup">Sign Up</a>
        </div>

        <div class="auth-footer auth-receive-row">
            <span>Receiving a file from another device?</span>
            <a href="/transfer" class="auth-receive-link">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3" stroke-linecap="round"
                          stroke-linejoin="round" />
                </svg>
                Receive File
            </a>
        </div>

        <div class="auth-divider">
            <span>or</span>
        </div>

        @if (!_showLoginCode)
        {
            <button type="button" class="btn btn-outline-secondary w-100 auth-social-btn" @onclick="StartLoginByCode"
                    disabled="@(_isLoading || _isGeneratingCode)">
                @if (_isGeneratingCode)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <span>Preparing…</span>
                }
                else
                {
                    <span>Add this device with a code</span>
                }
            </button>
        }
        else
        {
            <div class="login-code-panel text-center">
                <p class="mb-1">On a device you're already signed in on, open <strong>Devices</strong>,
                    choose <strong>Add device</strong>, and enter this code:</p>
                    <div class="login-code" aria-label="Login code">@_loginCode</div>
                    <p class="text-muted small mb-2">Waiting for approval…</p>
                    @if (_loginCodeError is not null)
                    {
                        <div class="alert alert-warning py-2">@_loginCodeError</div>
                    }
                    <button type="button" class="btn btn-link btn-sm" @onclick="CancelLoginByCode">Cancel</button>
                </div>
            }
        </div>
    </div>

    <style>
        .login-code-panel {
            margin-top: .5rem;
        }

        .login-code {
            font-family: var(--bs-font-monospace, monospace);
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: .4rem;
            padding: .5rem 0;
            user-select: all;
        }
    </style>

@code {
    private LoginModel _model = new();
    private string? _errorMessage;
    private bool _isLoading;
    private bool _externalHandled;

    private bool _showLoginCode;
    private bool _isGeneratingCode;
    private string? _loginCode;
    private string? _loginCodeError;
    private CancellationTokenSource? _pollCts;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _externalHandled)
            return;

        _externalHandled = true;
        await TryCompleteExternalLoginAsync();
    }

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            await AuthService.LoginAsync(_model.Email, _model.Password);
            Navigation.NavigateTo("/clipboard", forceLoad: false);
        }
        catch (AuthException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Unable to connect to the server. Please try again later.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void StartExternalLogin(string provider)
    {
        var redirectUri = Navigation.ToAbsoluteUri("/login").ToString();
        var url = AuthService.BuildExternalLoginUrl(provider, redirectUri);
        Navigation.NavigateTo(url, forceLoad: true);
    }

    private async Task StartLoginByCode()
    {
        _isGeneratingCode = true;
        _loginCodeError = null;
        _errorMessage = null;

        try
        {
            var info = await DeviceService.GenerateLoginCodeAsync(DeviceInfo.DeviceName, DeviceInfo.Platform);
            _loginCode = info.Code;
            _showLoginCode = true;

            _pollCts?.Cancel();
            _pollCts = new CancellationTokenSource();
            _ = WaitForApprovalAsync(_loginCode, _pollCts.Token);
        }
        catch (Exception ex)
        {
            _loginCodeError = $"Couldn't start device sign-in: {ex.Message}";
        }
        finally
        {
            _isGeneratingCode = false;
        }
    }

    private async Task WaitForApprovalAsync(string code, CancellationToken cancellationToken)
    {
        try
        {
            var result = await DeviceService.WaitForLoginApprovalAsync(code, cancellationToken);

            if (cancellationToken.IsCancellationRequested)
                return;

            switch (result.Status)
            {
                case LoginCodeStatus.Approved when result.Auth is not null:
                    await AuthService.CompleteExternalLoginAsync(
                        result.Auth.AccessToken, result.Auth.RefreshToken, result.Auth.AccessTokenExpiresAt);
                    await InvokeAsync(() => Navigation.NavigateTo("/clipboard", replace: true));
                    break;

                default:
                    await InvokeAsync(() =>
                    {
                        _loginCodeError = "This code expired. Please generate a new one.";
                        _showLoginCode = false;
                        _loginCode = null;
                        StateHasChanged();
                    });
                    break;
            }
        }
        catch (OperationCanceledException)
        {
            // Cancelled by the user or navigation — nothing to do.
        }
        catch (Exception ex)
        {
            await InvokeAsync(() =>
            {
                _loginCodeError = $"Device sign-in failed: {ex.Message}";
                StateHasChanged();
            });
        }
    }

    private void CancelLoginByCode()
    {
        _pollCts?.Cancel();
        _showLoginCode = false;
        _loginCode = null;
        _loginCodeError = null;
    }

    public void Dispose()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
    }

    private async Task TryCompleteExternalLoginAsync()
    {
        var uri = new Uri(Navigation.Uri);
        if (string.IsNullOrWhiteSpace(uri.Fragment))
            return;

        var fragment = uri.Fragment.TrimStart('#');
        var pairs = fragment.Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => part.Split('=', 2))
            .Where(parts => parts.Length == 2)
            .ToDictionary(parts => Uri.UnescapeDataString(parts[0]), parts => Uri.UnescapeDataString(parts[1]),
StringComparer.OrdinalIgnoreCase);

        if (!pairs.TryGetValue("access_token", out var accessToken) ||
            !pairs.TryGetValue("refresh_token", out var refreshToken) ||
            !pairs.TryGetValue("access_token_expires_at", out var expiresAtRaw) ||
            !DateTime.TryParse(expiresAtRaw, null, System.Globalization.DateTimeStyles.RoundtripKind, out var expiresAt))
        {
            return;
        }

        try
        {
            await AuthService.CompleteExternalLoginAsync(accessToken, refreshToken, expiresAt);
            Navigation.NavigateTo("/clipboard", replace: true);
        }
        catch (Exception ex)
        {
            _errorMessage = $"External sign-in failed: {ex.Message}";
            StateHasChanged();
        }
    }

    private sealed class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;
    }
}
